# Copy to /etc/pi4-noc/notify.env and keep it readable only by root/pi4.
# The dashboard sends nothing until email or webhook delivery is configured.

# Comma-separated recipients for morning digests and critical red alerts.
# PI4_NOC_NOTIFY_EMAIL_TO=you@example.com
# PI4_NOC_NOTIFY_EMAIL_FROM=Cabrera Network <pi4-noc@192.168.0.101>

# SMTP delivery. Prefer PI4_NOC_SMTP_PASSWORD_FILE over an inline password.
# PI4_NOC_SMTP_HOST=smtp.example.com
# PI4_NOC_SMTP_PORT=587
# PI4_NOC_SMTP_USER=you@example.com
# PI4_NOC_SMTP_PASSWORD_FILE=/etc/pi4-noc/smtp-password
# PI4_NOC_SMTP_TLS=1
# PI4_NOC_SMTP_SSL=0

# Optional generic JSON webhook for Slack, Discord bridges, Home Assistant, etc.
# PI4_NOC_NOTIFY_WEBHOOK_URL=https://example.com/hook

# Preferred account-free off-host delivery. Use a cryptographically random
# topic name and keep this URL out of source control; the topic acts as a
# password on the public ntfy service. A successful ntfy delivery suppresses
# the generic webhook, which then serves only as fallback.
# PI4_NOC_NOTIFY_NTFY_URL=https://ntfy.sh/private-random-topic
# PI4_NOC_NOTIFY_NTFY_CLICK_URL=http://192.168.0.101/
# PI4_NOC_NOTIFY_NTFY_TIMEOUT_SECONDS=10

# Optional form-encoded webhook mode for providers such as FormSubmit.
# Emails render as structured, emoji-labeled rows (Report, Scorecard,
# Failing now, ...) using the provider template below ("table" or "box").
# PI4_NOC_NOTIFY_WEBHOOK_URL=https://formsubmit.co/ajax/you@example.com
# PI4_NOC_NOTIFY_WEBHOOK_FORMAT=form
# PI4_NOC_NOTIFY_WEBHOOK_TEMPLATE=table
# PI4_NOC_NOTIFY_WEBHOOK_REFERER=http://192.168.0.101/
# PI4_NOC_NOTIFY_WEBHOOK_FROM=pi4-noc@cabrera-network.local
# PI4_NOC_NOTIFY_WEBHOOK_TIMEOUT_SECONDS=30

# Dashboard link shown at the bottom of digests and alerts. Falls back to
# PI4_NOC_NOTIFY_NTFY_CLICK_URL when unset; omitted entirely if neither is set.
# PI4_NOC_NOTIFY_LINK_URL=http://192.168.0.101/

# Portfolio API health is checked directly on Pi4 loopback. Tailscale Serve
# reachability is reported separately as a warning.
# PI4_NOC_PORTFOLIO_LOOPBACK_HEALTH_URL=http://127.0.0.1:8099/api/health
# PI4_NOC_PORTFOLIO_HEALTH_URL=https://ann-and-chris.tail83be27.ts.net:9443/api/health
# PI4_NOC_WEDDING_HEALTH_URL=https://ann-and-chris.tail83be27.ts.net/healthz

# Red critical alerts remain deduped through brief recoveries until cooldown.
# PI4_NOC_NOTIFY_CRITICAL_COOLDOWN_SECONDS=1800
