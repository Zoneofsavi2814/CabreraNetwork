[Unit]
Description=Cabrera Network dashboard
Wants=network-online.target
After=network-online.target AdGuardHome.service k3s.service

[Service]
Type=simple
User=pi4
Group=pi4
WorkingDirectory=/opt/pi4-noc
Environment=PYTHONUNBUFFERED=1
Environment=PI4_NOC_DIST=/opt/pi4-noc/dist
Environment=PI4_NOC_SUDO_HELPER=/opt/pi4-noc/server/sudo_ops.py
Environment=PI4_NOC_ADGUARD_CREDS=/home/pi4/.adguard-home-admin
Environment=PI4_NOC_AUTH_USER=pi4
Environment=PI4_NOC_SESSION_SECRET_FILE=/etc/pi4-noc/session-secret
Environment=PI4_NOC_STATE_DIR=/var/lib/pi4-noc
Environment=PI4_NOC_HOST=127.0.0.1
Environment=PI4_NOC_PORT=8080
EnvironmentFile=-/etc/pi4-noc/notify.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /opt/pi4-noc/server/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
