[Unit]
Description=Cabrera Network durable alert relay
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi4
Group=pi4
UMask=0077
EnvironmentFile=/etc/pi4-noc/notify.env
Environment=CABRERA_ALERT_RELAY_DB=/var/lib/cabrera-alert-relay/outbox.sqlite3
ExecStart=/opt/pi4-noc/scripts/cabrera-alert-relay.py --once
StateDirectory=cabrera-alert-relay
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cabrera-alert-relay
TimeoutStartSec=50

[Install]
WantedBy=multi-user.target
