[Unit]
Description=Pi4 homelab backup
Wants=network-online.target
After=network-online.target k3s.service AdGuardHome.service mnt-nas-brain.mount
RequiresMountsFor=/mnt/ssd /mnt/nas/brain

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pi4-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
